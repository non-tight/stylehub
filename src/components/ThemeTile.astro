---
/**
 * 홈 테마 타일: 대분류 하나를 큰 타일로 보여 주고 대분류 페이지로 연결한다.
 */
import type { Category } from "../lib/data";
import { getTheme } from "../lib/themes";
import { withBase } from "../lib/url";

interface Props {
  category: Category;
  /** 이 대분류의 상품 수 */
  count: number;
}

const { category, count } = Astro.props;
const theme = getTheme(category.id);
const subNames = category.subcategories.map((s) => s.name).join(" · ");
---

<a
  class="tile"
  href={withBase(`/category/${category.id}/`)}
  style={`--tile-bg: ${theme.bg}; --tile-fg: ${theme.fg}; --tile-accent: ${theme.accent};`}
>
  <span class="count">{count > 0 ? `상품 ${count}개` : "준비 중"}</span>
  <h2 class="name">{category.name}</h2>
  <p class="desc">{category.description}</p>
  <p class="subs">{subNames}</p>
  <span class="arrow" aria-hidden="true">→</span>
</a>

<style>
  .tile {
    position: relative;
    display: grid;
    align-content: end;
    gap: var(--space-1);
    min-height: 168px;
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: var(--tile-bg);
    color: var(--tile-fg);
    text-decoration: none;
    overflow: hidden;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  /* 은은한 원형 무늬 */
  .tile::before {
    content: "";
    position: absolute;
    width: 180px;
    height: 180px;
    right: -50px;
    top: -60px;
    border-radius: 50%;
    background: rgb(255 255 255 / 8%);
  }
  .tile:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 24px -14px rgb(23 26 33 / 55%);
  }
  .count {
    position: absolute;
    top: var(--space-4);
    left: var(--space-6);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--tile-accent);
  }
  .name {
    font-size: var(--text-xl);
    font-weight: 800;
  }
  .desc {
    font-size: var(--text-sm);
    opacity: 0.92;
  }
  .subs {
    font-size: var(--text-xs);
    opacity: 0.7;
  }
  .arrow {
    position: absolute;
    right: var(--space-6);
    bottom: var(--space-6);
    font-size: var(--text-lg);
    opacity: 0.8;
  }
</style>
