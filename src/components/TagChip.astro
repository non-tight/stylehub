---
/**
 * 태그 칩 링크 (전체 태그 페이지, 태그 페이지의 "다른 태그"에서 사용)
 * 색상 태그면 색 동그라미를 붙인다.
 */
import type { Tag } from "../lib/data";
import { getSwatch } from "../lib/colors";
import { withBase } from "../lib/url";

interface Props {
  tag: Tag;
  count: number;
  isColor?: boolean;
}

const { tag, count, isColor = false } = Astro.props;
---

<a class="chip" href={withBase(`/tags/${tag.id}/`)}>
  {isColor && <span class="dot" style={`background: ${getSwatch(tag.id).bg};`} aria-hidden="true" />}
  <span>#{tag.name}</span>
  <span class="n">{count}</span>
</a>

<style>
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px var(--space-3);
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: var(--color-surface);
    font-size: var(--text-sm);
    text-decoration: none;
    color: var(--color-fg);
  }
  .chip:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px rgb(23 26 33 / 15%);
  }
  .n {
    font-size: var(--text-xs);
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }
</style>
