---
/**
 * 상품 목록 + 색상·가격대 필터 + 정렬
 * - 필터 선택지는 이 목록에 있는 상품의 색상·가격대만 보여 준다.
 * - 색상·가격대는 각각 하나씩 고르고, 고른 값은 주소(?color=red&price=under-10k&sort=price)에 남는다.
 * - 자바스크립트가 꺼져 있으면 필터·정렬 없이 전체 상품을 새로 추가된 순으로 보여 준다.
 * (Next.js라면 useState로 목록을 거르는 부분을, Astro에서는 아래 <script>가 화면에서 처리한다)
 */
import type { Product } from "../lib/data";
import { colorTags, priceRanges } from "../lib/data";
import { getSwatch } from "../lib/colors";
import ProductCard from "./ProductCard.astro";

interface Props {
  products: Product[];
  /** 상품이 하나도 없을 때 보여 줄 문구 */
  emptyText?: string;
}

const { products, emptyText = "이 분류의 상품을 준비하고 있어요." } = Astro.props;

// 이 목록에 실제로 있는 색상·가격대만 (사전 순서 유지)
const colorOptions = colorTags.filter((t) => products.some((p) => p.color === t.id));
const priceOptions = priceRanges.filter((r) => products.some((p) => p.priceRange === r.id));
const priceOrder = (id: string) => priceRanges.findIndex((r) => r.id === id);
---

{
  products.length === 0 ? (
    <div class="empty">
      <p>{emptyText}</p>
    </div>
  ) : (
    <div class="list" data-product-list>
      <div class="controls" data-controls hidden>
        {colorOptions.length > 1 && (
          <div class="group" role="group" aria-label="색상">
            <span class="label">색상</span>
            <div class="opts">
              <button type="button" class="chip" data-filter="color" data-value="" aria-pressed="true">
                전체
              </button>
              {colorOptions.map((c) => (
                <button type="button" class="chip" data-filter="color" data-value={c.id} aria-pressed="false">
                  <span class="dot" style={`background: ${getSwatch(c.id).bg};`} aria-hidden="true" />
                  {c.name}
                </button>
              ))}
            </div>
          </div>
        )}
        {priceOptions.length > 1 && (
          <div class="group" role="group" aria-label="가격대">
            <span class="label">가격</span>
            <div class="opts">
              <button type="button" class="chip" data-filter="price" data-value="" aria-pressed="true">
                전체
              </button>
              {priceOptions.map((r) => (
                <button type="button" class="chip" data-filter="price" data-value={r.id} aria-pressed="false">
                  {r.name}
                </button>
              ))}
            </div>
          </div>
        )}
        <div class="bar">
          <p class="count" data-count aria-live="polite">
            {products.length}개
          </p>
          <label class="sort">
            <span class="sr-only">정렬</span>
            <select id="product-sort" data-sort>
              <option value="new">새로 추가된 순</option>
              <option value="price">낮은 가격대 순</option>
            </select>
          </label>
        </div>
      </div>

      <ul class="grid" data-grid>
        {products.map((p, i) => (
          <li data-color={p.color} data-price={p.priceRange} data-price-order={priceOrder(p.priceRange)} data-new-order={i}>
            <ProductCard product={p} />
          </li>
        ))}
      </ul>

      <div class="no-result" data-no-result hidden>
        <p>조건에 맞는 상품이 없어요.</p>
        <button type="button" class="reset" data-reset>
          필터 초기화
        </button>
      </div>
    </div>
  )
}

<script>
  function setupList(root: HTMLElement) {
    const controls = root.querySelector<HTMLElement>("[data-controls]");
    const grid = root.querySelector<HTMLElement>("[data-grid]");
    const countEl = root.querySelector<HTMLElement>("[data-count]");
    const noResult = root.querySelector<HTMLElement>("[data-no-result]");
    const sortEl = root.querySelector<HTMLSelectElement>("[data-sort]");
    if (!controls || !grid || !countEl || !noResult || !sortEl) return;

    const items = Array.from(grid.children) as HTMLElement[];
    const buttons = Array.from(controls.querySelectorAll<HTMLButtonElement>("button[data-filter]"));
    const validValues = (key: string) =>
      new Set(buttons.filter((b) => b.dataset.filter === key).map((b) => b.dataset.value ?? ""));

    // 주소의 ?color=&price=&sort= 값 읽기 (없는 값은 무시)
    const params = new URLSearchParams(location.search);
    const state = {
      color: validValues("color").has(params.get("color") ?? "") ? (params.get("color") ?? "") : "",
      price: validValues("price").has(params.get("price") ?? "") ? (params.get("price") ?? "") : "",
      sort: params.get("sort") === "price" ? "price" : "new",
    };

    const render = () => {
      // 버튼 눌림 표시
      for (const b of buttons) {
        const key = b.dataset.filter as "color" | "price";
        b.setAttribute("aria-pressed", String(state[key] === (b.dataset.value ?? "")));
      }
      sortEl.value = state.sort;

      // 정렬
      const key = state.sort === "price" ? "priceOrder" : "newOrder";
      const sorted = [...items].sort((a, b) => {
        const d = Number(a.dataset[key]) - Number(b.dataset[key]);
        return d !== 0 ? d : Number(a.dataset.newOrder) - Number(b.dataset.newOrder);
      });
      for (const el of sorted) grid.appendChild(el);

      // 필터
      let shown = 0;
      for (const el of items) {
        const ok =
          (!state.color || el.dataset.color === state.color) && (!state.price || el.dataset.price === state.price);
        el.hidden = !ok;
        if (ok) shown++;
      }
      const filtered = state.color || state.price;
      countEl.textContent = filtered ? `${items.length}개 중 ${shown}개` : `${items.length}개`;
      noResult.hidden = shown > 0;
      grid.hidden = shown === 0;

      // 주소에 남기기 (공유·새로고침해도 같은 화면)
      const next = new URLSearchParams();
      if (state.color) next.set("color", state.color);
      if (state.price) next.set("price", state.price);
      if (state.sort !== "new") next.set("sort", state.sort);
      const qs = next.toString();
      history.replaceState(null, "", qs ? `?${qs}` : location.pathname);
    };

    controls.addEventListener("click", (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>("button[data-filter]");
      if (!b) return;
      const key = b.dataset.filter as "color" | "price";
      state[key] = b.dataset.value ?? "";
      render();
    });
    sortEl.addEventListener("change", () => {
      state.sort = sortEl.value === "price" ? "price" : "new";
      render();
    });
    root.querySelector("[data-reset]")?.addEventListener("click", () => {
      state.color = "";
      state.price = "";
      render();
    });

    controls.hidden = false;
    render();
  }

  document.querySelectorAll<HTMLElement>("[data-product-list]").forEach(setupList);
</script>

<style>
  .list {
    display: grid;
    gap: var(--space-4);
    min-width: 0;
  }
  .controls {
    display: grid;
    gap: var(--space-3);
  }
  .controls[hidden] {
    display: none;
  }
  .group {
    display: flex;
    align-items: start;
    gap: var(--space-3);
    min-width: 0;
  }
  .label {
    flex: none;
    width: 2.5em;
    padding-top: 6px;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-muted);
  }
  .opts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    min-width: 0;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px var(--space-3);
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-fg);
    font: inherit;
    font-size: var(--text-sm);
    cursor: pointer;
  }
  .chip:hover {
    border-color: var(--color-accent);
  }
  .chip[aria-pressed="true"] {
    border-color: var(--color-accent);
    background: var(--color-accent-soft);
    color: var(--color-accent);
    font-weight: 600;
  }
  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px rgb(23 26 33 / 15%);
  }
  .bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-line);
  }
  .count {
    font-size: var(--text-sm);
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }
  .sort select {
    font: inherit;
    font-size: var(--text-sm);
    padding: 5px var(--space-2);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    color: var(--color-fg);
  }
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
  }
  .grid[hidden] {
    display: none;
  }
  .grid > li {
    display: flex;
  }
  .grid > li[hidden] {
    display: none;
  }
  .grid > li > :global(*) {
    flex: 1;
  }
  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-4);
    }
  }
  @media (min-width: 1100px) {
    .grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .empty,
  .no-result {
    display: grid;
    gap: var(--space-3);
    justify-items: center;
    text-align: center;
    padding: var(--space-12) var(--space-4);
    border: 1px dashed var(--color-line);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    color: var(--color-muted);
  }
  .no-result[hidden] {
    display: none;
  }
  .reset {
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 600;
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    color: var(--color-fg);
    cursor: pointer;
  }
  .reset:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
</style>
