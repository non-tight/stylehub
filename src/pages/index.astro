---
// 홈 임시 화면. 8단계에서 테마 타일 + 가로 줄 디자인으로 바꾼다.
import BaseLayout from "../layouts/BaseLayout.astro";
import { categories } from "../lib/data";
---

<BaseLayout>
  <section class="container intro">
    <h1>스타일허브</h1>
    <p>스타일과 트렌드로 고르는 합리적인 가격의 상품 모음을 준비하고 있습니다.</p>
    <p class="themes">준비 중인 테마: {categories.map((c) => c.name).join(" · ")}</p>
  </section>
</BaseLayout>

<style>
  .intro {
    display: grid;
    gap: var(--space-3);
    padding-block: var(--space-12);
    text-align: center;
    justify-items: center;
  }
  h1 {
    font-size: var(--text-2xl);
  }
  p {
    color: var(--color-muted);
  }
</style>
