---
/**
 * 소개 페이지: /about/
 * 안내 문구를 바꿀 때는 CLAUDE.md의 "사이트 공통 요소"와 하단 안내문(Footer.astro)도 같이 확인한다.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import { categories } from "../lib/data";
import { withBase } from "../lib/url";

const themeNames = categories.map((c) => c.name).join(", ");
---

<BaseLayout title="소개" description="스타일허브는 브랜드 대신 스타일과 분위기로 고르는 합리적인 가격의 상품 모음입니다.">
  <div class="container page">
    <nav class="crumb" aria-label="현재 위치">
      <ol>
        <li><a href={withBase("/")}>홈</a></li>
        <li aria-current="page">소개</li>
      </ol>
    </nav>

    <h1>소개</h1>

    <section>
      <h2>스타일허브는</h2>
      <p>
        브랜드 대신 스타일과 분위기로 상품을 고를 수 있게, 테마별로 비슷한 느낌의 합리적인 가격 상품을 모아 소개하는
        사이트입니다.
      </p>
    </section>

    <section>
      <h2>이렇게 이용하세요</h2>
      <p>
        테마({themeNames})를 고르고, 색상·가격대로 좁혀 본 뒤, "판매처 보기"를 누르면 판매처 페이지로 이동합니다.
      </p>
    </section>

    <section>
      <h2>알아 두세요</h2>
      <ul>
        <li>스타일허브는 상품을 직접 판매하지 않으며, 제휴 링크를 통한 수수료도 받지 않습니다.</li>
        <li>가격·재고·배송·교환·환불 등 상품 정보와 거래는 각 판매처의 책임입니다.</li>
        <li>표시된 가격대는 소개 당시 기준이며, 실제 가격은 판매처 페이지에서 확인해 주세요.</li>
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .page {
    display: grid;
    gap: var(--space-6);
    max-width: 760px;
    padding-block: var(--space-6) var(--space-8);
  }
  .crumb ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--space-1);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .crumb li + li::before {
    content: "›";
    margin-right: var(--space-1);
  }
  .crumb a {
    color: var(--color-muted);
    text-decoration: none;
  }
  h1 {
    font-size: var(--text-xl);
    font-weight: 800;
  }
  section {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
  }
  h2 {
    font-size: var(--text-lg);
    font-weight: 700;
  }
  p,
  li {
    max-width: 65ch;
  }
  ul {
    margin: 0;
    padding-left: 1.2em;
    display: grid;
    gap: var(--space-2);
  }
</style>
