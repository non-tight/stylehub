---
/**
 * 태그별 상품 페이지: /tags/[tag]/  (예: /tags/red/)
 * tags.json의 태그마다 자동으로 만들어진다. 상품이 없어도 "준비 중" 안내와 함께 만들어진다.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProductList from "../../components/ProductList.astro";
import TagChip from "../../components/TagChip.astro";
import type { Tag, TagGroup } from "../../lib/data";
import { tagGroups, getProductsByTag } from "../../lib/data";
import { withBase } from "../../lib/url";

export function getStaticPaths() {
  return tagGroups.flatMap((group) => group.tags.map((tag) => ({ params: { tag: tag.id }, props: { tag, group } })));
}

interface Props {
  tag: Tag;
  group: TagGroup;
}

const { tag, group } = Astro.props;
const products = getProductsByTag(tag.id);

// 같은 종류의 다른 태그 중 상품이 있는 것 (최대 10개)
const related = group.tags
  .filter((t) => t.id !== tag.id)
  .map((t) => ({ tag: t, count: getProductsByTag(t.id).length }))
  .filter((x) => x.count > 0)
  .slice(0, 10);
---

<BaseLayout title={`#${tag.name}`} description={`${group.name} 태그 "${tag.name}"로 모은 상품`}>
  <div class="container page">
    <nav class="crumb" aria-label="현재 위치">
      <ol>
        <li><a href={withBase("/")}>홈</a></li>
        <li><a href={withBase("/tags/")}>태그</a></li>
        <li aria-current="page">#{tag.name}</li>
      </ol>
    </nav>

    <header class="head">
      <p class="kind">{group.name} 태그</p>
      <h1>
        #{tag.name}
        <span class="total">{products.length}개</span>
      </h1>
    </header>

    <ProductList products={products} emptyText="이 태그의 상품을 준비하고 있어요." />

    {
      related.length > 0 && (
        <section class="related">
          <h2>다른 {group.name} 태그</h2>
          <div class="chips">
            {related.map((x) => (
              <TagChip tag={x.tag} count={x.count} isColor={group.id === "color"} />
            ))}
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
  .page {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
    padding-block: var(--space-6) var(--space-8);
  }
  .crumb ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .crumb li + li::before {
    content: "›";
    margin-right: var(--space-1);
  }
  .crumb a {
    color: var(--color-muted);
    text-decoration: none;
  }
  .crumb a:hover {
    color: var(--color-fg);
    text-decoration: underline;
  }
  .head {
    display: grid;
    gap: var(--space-1);
  }
  .kind {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--color-muted);
  }
  h1 {
    font-size: var(--text-xl);
    font-weight: 800;
  }
  .total {
    margin-left: var(--space-2);
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--color-muted);
  }
  .related {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-6);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-line);
  }
  .related h2 {
    font-size: var(--text-base);
    font-weight: 700;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
</style>
