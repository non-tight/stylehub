---
/**
 * 없는 주소로 들어왔을 때 보여 줄 페이지. 빌드하면 dist/404.html이 되고 GitHub Pages가 자동으로 사용한다.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import { categories } from "../lib/data";
import { withBase } from "../lib/url";
---

<BaseLayout title="페이지를 찾을 수 없어요" noindex>
  <section class="container page">
    <p class="code">404</p>
    <h1>페이지를 찾을 수 없어요</h1>
    <p>주소가 바뀌었거나 삭제된 페이지예요. 아래에서 다시 둘러보세요.</p>
    <ul>
      <li><a class="primary" href={withBase("/")}>홈으로</a></li>
      {categories.map((c) => <li><a href={withBase(`/category/${c.id}/`)}>{c.name}</a></li>)}
    </ul>
  </section>
</BaseLayout>

<style>
  .page {
    display: grid;
    gap: var(--space-3);
    justify-items: center;
    text-align: center;
    padding-block: var(--space-12);
  }
  .code {
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--color-accent);
  }
  h1 {
    font-size: var(--text-xl);
    font-weight: 800;
  }
  p {
    color: var(--color-muted);
  }
  ul {
    list-style: none;
    margin: var(--space-3) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
  }
  a {
    display: inline-block;
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: var(--color-surface);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
  }
  a:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  a.primary {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-on-accent);
  }
</style>
